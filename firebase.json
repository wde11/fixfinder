{
    "hosting": {
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "index.php",
            ".htaccess"
        ],
        "rewrites": [
            {
                "source": "**",
                "run": {
                    "serviceId": "fixfinder",
                    "region": "us-central1"
                }
            }
        ]
    }
}
