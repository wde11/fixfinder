{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "builds": [
        {
            "src": "public/index.php",
            "use": "vercel-php@0.7.1"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/(.*\\.(?:css|js|png|jpg|jpeg|gif|ico|svg|woff2?)$)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.php"
        }
    ]
}
